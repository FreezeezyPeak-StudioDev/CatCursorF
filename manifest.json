{
  "manifest_version": 3,
  "name": "CatCursorF",
  "version": "1.0",
  "description": "CatCursorF de Freezeezy Peak. GitHub: github.com/FreezeezyPeak-StudioDev · GitLab: gitlab.com/freezeezypeak.studiodev · Correo: freezeezypeak.studiodev@gmail.com.",
  "default_locale": "es",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "catcursorf@freezeezypeak.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  
  "icons": {
    "48": "assets/icons/iconNormal.svg",
    "96": "assets/icons/iconNormal.svg"
  },
  
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  
  "host_permissions": [
    "<all_urls>",
    "about:blank",
    "about:home"
  ],
  
  "background": {
    "scripts": ["background.js"]
  },
  
  "action": {
    "default_title": "CatCursorF",
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icons/iconNormal.svg"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>", "about:blank", "about:home"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": [
        "assets/cursors/Cat - Normal Select.cur",
        "assets/cursors/Cat - Link Select B.cur",
        "assets/cursors/Cat - Text Select.cur",
        "assets/cursors/Cat - Help Select.cur",
        "assets/cursors/Cat - Pen.cur",
        "assets/cursors/Cat - Precision Select.cur",
        "assets/cursors/Cat - Unavailable.cur",
        "assets/cursors/Cat - Vertical Resize.cur",
        "assets/fx/Cat_meow.mp3",
        "assets/fx/matthewvakaliuk73627-mouse-click.mp3",
        "assets/cursors/README.txt"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}