{
  "manifest_version": 3,
  "name": "CatCursorF",
  "version": "1.0.2",
  "description": "...",
  "default_locale": "es",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "catcursorf@freezeezypeak.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  
  "icons": {
    "48": "assets/icons/iconNormal.svg",
    "96": "assets/icons/iconNormal.svg"
  },
  
  "permissions": ["storage", "tabs", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  
  "background": {
    "scripts": ["background.js"]
  },
  
  "action": {
    "default_title": "CatCursorF",
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icons/iconNormal.svg"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["assets/cursors/*", "assets/fx/*"],
      "matches": ["<all_urls>"],
      "extension_ids": ["darksnowf@freezeezy.peak"]
    }
  ]
}